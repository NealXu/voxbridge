# Git Attributes - 强制 LF 行尾，防止 CRLF 转换干扰 UTF-8
# https://git-scm.com/docs/gitattributes

# Auto-detect text files and normalize to LF
* text=auto eol=lf

# 明确指定文本文件类型
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 源代码
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# 配置文件
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# 二进制文件（不转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary