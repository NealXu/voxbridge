{
  "name": "voxbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice-controlled Claude Code CLI: press-to-talk, transcribe locally with Whisper, drive Claude Code by voice.",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "worker": ".venv\\Scripts\\python.exe stt_worker/main.py",
    "check-encoding": "node scripts/check-encoding.cjs",
    "check-encoding:all": "node scripts/check-encoding.cjs --all"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.231",
    "ink": "^7.1.1",
    "node-global-key-listener": "^0.3.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
